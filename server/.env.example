# --- Servidor ---
PORT=3001
NODE_ENV=development
# URL pública do sistema (usada nos links dos e-mails)
APP_URL=http://localhost:5173
# Obrigatório em produção (mín. 24 caracteres): openssl rand -base64 32
JWT_SECRET=troque-por-uma-chave-longa-e-aleatoria
# Se o app fica atrás de proxy/Nginx, defina 1 para o limitador de tentativas ver o IP real
# TRUST_PROXY=1

# --- Banco de dados ---
# Sem DB_HOST o sistema usa SQLite local (server/data/agendamento.db) — ideal para desenvolvimento.
# Para produção em MySQL/MariaDB, preencha:
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=harmonize_agendamento

# --- Administrador inicial (criado no primeiro start, se não existir nenhum) ---
ADMIN_NAME=Administração
ADMIN_EMAIL=admin@harmonizeoser.com.br
# Em desenvolvimento, sem ADMIN_PASSWORD a senha padrão é "admin123". Em produção defina uma senha forte.
ADMIN_PASSWORD=

# Popula clientes e reservas de exemplo (somente desenvolvimento)
SEED_DEMO=false

# --- E-mail (opcional; sem isso os e-mails só aparecem no log) ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
# Recebe um aviso a cada nova reserva
NOTIFY_EMAIL=

# Em produção com HTTPS, defina FORCE_HTTPS=true para o navegador promover requisições http->https
# FORCE_HTTPS=true

# --- Pagamentos online (Pagar.me) ---
# Chave secreta do painel do Pagar.me (Configurações → Chaves). Use sk_test_... para testar e sk_... em produção.
# NUNCA coloque essa chave no front-end nem no repositório.
PAGARME_SECRET_KEY=
# Chave pública (pk_test_... / pk_...): usada no navegador só para tokenizar o cartão. O domínio do site precisa estar
# cadastrado no painel do Pagar.me para a tokenização funcionar.
PAGARME_PUBLIC_KEY=
# Segredo que vai no endereço do webhook (qualquer texto longo e aleatório: openssl rand -hex 24)
PAGARME_WEBHOOK_TOKEN=
# Opcional (padrão: https://api.pagar.me/core/v5)
# PAGARME_API_URL=

# Vercel Cron (rota /api/cron/sweep)
CRON_SECRET=

# Pasta das fotos enviadas pelo painel. Em hospedagem que recria a pasta do app a cada deploy (ex.: Hostinger),
# aponte para um lugar fora do código (ex.: /home/SEU_USUARIO/uploads-agendamentos). Vazio = server/uploads.
# UPLOADS_DIR=
